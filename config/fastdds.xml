<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>car_shm</transport_id><type>SHM</type>
      <!-- Bytes: enough for multiple uncompressed 640 by 480 RGB images. -->
      <segment_size>16777216</segment_size>
      <port_queue_capacity>1024</port_queue_capacity>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>car_udp</transport_id><type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize><receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="car_participant" is_default_profile="true">
    <rtps><userTransports><transport_id>car_shm</transport_id><transport_id>car_udp</transport_id></userTransports><useBuiltinTransports>false</useBuiltinTransports></rtps>
  </participant>
</profiles>
