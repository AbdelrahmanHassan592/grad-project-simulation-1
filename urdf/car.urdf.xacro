<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="test_car">
<!-- Geometry in m, mass in kg, rotation in rad, inertia in kg m^2. -->
<xacro:arg name="use_gazebo" default="false"/>
<xacro:property name="body_length" value="0.6"/>
<xacro:property name="body_width" value="0.3"/>
<xacro:property name="body_height" value="0.1"/>
<xacro:property name="body_mass" value="5.0"/>
<xacro:property name="wheel_radius" value="0.05"/>
<xacro:property name="wheel_width" value="0.04"/>
<xacro:property name="wheel_mass" value="0.4"/>
<xacro:property name="wheel_x" value="0.2"/>
<xacro:property name="lidar_radius" value="0.04"/>
<xacro:property name="lidar_height" value="0.05"/>
<xacro:property name="lidar_mass" value="0.15"/>
<xacro:property name="lidar_x" value="0.15"/>
<xacro:property name="camera_length" value="0.02"/>
<xacro:property name="camera_width" value="0.06"/>
<xacro:property name="camera_height" value="0.03"/>
<xacro:property name="camera_mass" value="0.05"/>
<xacro:property name="camera_z" value="0.02"/>
<xacro:property name="imu_length" value="0.02"/>
<xacro:property name="imu_width" value="0.02"/>
<xacro:property name="imu_height" value="0.01"/>
<xacro:property name="imu_mass" value="0.01"/>
<xacro:property name="optical_mass" value="1e-06"/>

<xacro:property name="wheel_y" value="${body_width/2 + wheel_width/2}"/>
<xacro:macro name="box_inertia" params="m x y z">
 <inertial><mass value="${m}"/><inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/></inertial>
</xacro:macro>
<xacro:macro name="cylinder_inertia" params="m r h">
 <inertial><mass value="${m}"/><inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/></inertial>
</xacro:macro>
<material name="chassis"><color rgba="0.1 0.35 0.8 1"/></material>
<material name="rubber"><color rgba="0.08 0.08 0.08 1"/></material>
<material name="lidar"><color rgba="0.9 0.25 0.1 1"/></material>
<material name="camera"><color rgba="0.2 0.8 0.3 1"/></material>
<material name="imu"><color rgba="0.9 0.8 0.1 1"/></material>
<xacro:macro name="box_link" params="name x y z m color collision:=true">
 <link name="${name}"><xacro:box_inertia m="${m}" x="${x}" y="${y}" z="${z}"/>
 <visual><geometry><box size="${x} ${y} ${z}"/></geometry><material name="${color}"/></visual>
 <xacro:if value="${collision}"><collision><geometry><box size="${x} ${y} ${z}"/></geometry></collision></xacro:if></link>
</xacro:macro>
<xacro:box_link name="base_link" x="${body_length}" y="${body_width}" z="${body_height}" m="${body_mass}" color="chassis"/>
<xacro:macro name="wheel" params="name x y">
 <link name="${name}_wheel_link"><xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
 <visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="rubber"/></visual>
 <collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision></link>
 <joint name="${name}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${name}_wheel_link"/>
 <origin xyz="${x} ${y} 0" rpy="${-pi/2} 0 0"/><axis xyz="0 0 1"/><dynamics damping="0.01" friction="0.0"/></joint>
 <gazebo reference="${name}_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2><fdir1>0 0 1</fdir1></gazebo>
</xacro:macro>
<xacro:wheel name="front_left" x="${wheel_x}" y="${wheel_y}"/>
<xacro:wheel name="front_right" x="${wheel_x}" y="${-wheel_y}"/>
<xacro:wheel name="rear_left" x="${-wheel_x}" y="${wheel_y}"/>
<xacro:wheel name="rear_right" x="${-wheel_x}" y="${-wheel_y}"/>
<link name="lidar_link"><xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
 <visual><geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry><material name="lidar"/></visual>
 <collision><geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry></collision></link>
<joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="${lidar_x} 0 ${body_height/2+lidar_height/2}"/></joint>
<xacro:box_link name="camera_link" x="${camera_length}" y="${camera_width}" z="${camera_height}" m="${camera_mass}" color="camera"/>
<joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="${body_length/2+camera_length/2} 0 ${camera_z}"/></joint>
<link name="camera_optical_link"><xacro:box_inertia m="${optical_mass}" x="${camera_length}" y="${camera_width}" z="${camera_height}"/></link>
<joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_link"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
<xacro:box_link name="imu_link" x="${imu_length}" y="${imu_width}" z="${imu_height}" m="${imu_mass}" color="imu" collision="false"/>
<joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/></joint>
<xacro:if value="$(arg use_gazebo)">
 <!-- The 0.10 m chassis is flush with the 0.05 m-radius tire contact plane.
      Its underside acts as a frictionless skid plate so it cannot pin yaw. -->
 <gazebo reference="base_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

 <!-- Tire slip compliance is dimensionless; normal load N, gravity m/s^2. -->
 <xacro:macro name="slip_wheel" params="name">
  <wheel link_name="${name}_wheel_link"><slip_compliance_lateral>5.0</slip_compliance_lateral><slip_compliance_longitudinal>0.0</slip_compliance_longitudinal><wheel_normal_force>${(body_mass+4*wheel_mass+lidar_mass+camera_mass+imu_mass+optical_mass)*9.8/4}</wheel_normal_force><wheel_radius>${wheel_radius}</wheel_radius></wheel>
 </xacro:macro>
 <gazebo><plugin filename="gz-sim-wheel-slip-system" name="gz::sim::systems::WheelSlip">
  <xacro:slip_wheel name="front_left"/><xacro:slip_wheel name="front_right"/><xacro:slip_wheel name="rear_left"/><xacro:slip_wheel name="rear_right"/>
 </plugin><plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
 <left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
 <right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
 <wheel_separation>${2*wheel_y}</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius>
 <topic>cmd_vel</topic><odom_topic>odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><tf_topic>/tf</tf_topic><odom_publish_frequency>50</odom_publish_frequency></plugin>
 <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>joint_states</topic><update_rate>50</update_rate></plugin></gazebo>
 <gazebo reference="lidar_link"><sensor name="lidar" type="gpu_lidar"><topic>scan</topic><gz_frame_id>lidar_link</gz_frame_id><always_on>true</always_on><update_rate>10</update_rate>
 <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan><range><min>0.12</min><max>12</max><resolution>0.01</resolution></range></lidar></sensor></gazebo>
 <gazebo reference="camera_link"><sensor name="camera" type="camera"><topic>camera/image_raw</topic><gz_frame_id>camera_optical_link</gz_frame_id><always_on>true</always_on><update_rate>15</update_rate>
 <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.02</near><far>50</far></clip></camera></sensor></gazebo>
 <gazebo reference="imu_link"><sensor name="imu" type="imu"><topic>imu</topic><gz_frame_id>imu_link</gz_frame_id><always_on>true</always_on><update_rate>50</update_rate><imu/></sensor></gazebo>
</xacro:if>
</robot>
